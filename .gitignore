# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
.eggs/
build/
dist/
pip-wheel-metadata/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.cache/

# Virtual environments
.venv/
venv/
ENV/
env/

# Conda
.conda/

# Jupyter
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.cursor/
*.code-workspace

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Generated scientific data and outputs (never commit large artifacts)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep
outputs/figures/*
!outputs/figures/.gitkeep
outputs/models/*
!outputs/models/.gitkeep
outputs/reports/*
!outputs/reports/.gitkeep
outputs/tables/*
!outputs/tables/.gitkeep
experiments/*
!experiments/.gitkeep

# Local experiment dumps
*.npz
*.npy
*.joblib
*.pkl
*.pickle

# Keep lockfile and source
!requirements-lock.txt

# Logs
*.log
logs/

# Environment / secrets — never commit credentials
.env
.env.*
!.env.example
credentials.json
secrets.yaml
*.pem
*.key
